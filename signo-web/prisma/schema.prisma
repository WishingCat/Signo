// Prisma schema for Signo W1 (minimal subset)
// See plan §Task 2 and spec §Prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  passwordHash   String
  nickname       String
  friendCode     String        @unique
  avatarSeed     String        @default("default")
  role           String        @default("user") // user | admin
  tier           Int           @default(1)      // 1..7 森林段位
  pkScore        Int           @default(1000)
  pkWins         Int           @default(0)
  pkLosses       Int           @default(0)
  totalXp        Int           @default(0)
  weeklyXp       Int           @default(0)
  leaves         Int           @default(0)      // 落叶货币
  currentStreak  Int           @default(0)
  bestStreak     Int           @default(0)
  lastClearDate  String?                        // YYYY-MM-DD, 最近一次通关日
  createdAt      DateTime      @default(now())
  attempts       Attempt[]
  clears         LessonClear[]
  daily          DailyStat[]
  badges         UserBadge[]
  teamMemberships TeamMember[]
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  emoji       String
  sortOrder   Int         @default(0)
  unlocks     UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  badge      Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String                            // canonical ordered: userAId < userBId
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Unit {
  id          String   @id @default(cuid())
  order       Int
  title       String
  description String
  iconKey     String
  lessons     Lesson[]
}

model Lesson {
  id        String        @id @default(cuid())
  unitId    String
  order     Int
  title     String
  unit      Unit          @relation(fields: [unitId], references: [id])
  questions Question[]
  clears    LessonClear[]
}

model Question {
  id            String    @id @default(cuid())
  lessonId      String
  order         Int
  type          String // sign2word | word2sign
  promptText    String?
  promptMediaId String?
  promptMedia   Media?    @relation(fields: [promptMediaId], references: [id])
  choicesJson   String // JSON string array
  answerIndex   Int
  explanation   String?
  lesson        Lesson    @relation(fields: [lessonId], references: [id])
  attempts      Attempt[]
}

model Media {
  id         String     @id @default(cuid())
  kind       String // image | video
  path       String // served under /signs/... for images
  durationMs Int?
  signer     String?
  license    String?
  questions  Question[]
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  isCorrect  Boolean
  answeredAt DateTime @default(now())
  msSpent    Int
  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
}

model LessonClear {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  clearedAt DateTime @default(now())
  stars     Int
  user      User     @relation(fields: [userId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
}

model DailyStat {
  userId               String
  date                 String   // YYYY-MM-DD
  xp                   Int      @default(0)
  leaves               Int      @default(0)
  lessonsCleared       Int      @default(0)
  dailyQuestClaimedAt  DateTime?
  user                 User     @relation(fields: [userId], references: [id])

  @@id([userId, date])
}

// ——— 团队协作（每日任务全员达成则全员获得当天 XP +19~21% 加成） ———

model Team {
  id        String           @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime         @default(now())
  members   TeamMember[]
  invites   TeamInvite[]
  bonuses   TeamBonusEvent[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id          String    @id @default(cuid())
  teamId      String
  inviteeId   String
  inviterId   String
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  team        Team      @relation(fields: [teamId], references: [id])

  @@unique([teamId, inviteeId])
  @@index([inviteeId, status])
}

model TeamBonusEvent {
  id          String   @id @default(cuid())
  teamId      String
  date        String   // YYYY-MM-DD（与 DailyStat.date 同格式）
  pctBps      Int      // basis points: 1900 / 2000 / 2100
  memberCount Int
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, date])
}
